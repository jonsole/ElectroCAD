{
  "name": "electrocad",
  "productName": "ElectroCAD",
  "version": "0.1.0",
  "description": "Schematic capture and 2/4-layer PCB layout that runs in the browser or as a desktop app.",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node tools/run.js",
    "app": "node tools/run.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:smoke": "vite build && node tools/smoke.js"
  },
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "electron": "^45.3.2",
    "vite": "^8.3.8"
  },
  "private": true
}
